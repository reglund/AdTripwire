[Unit]
Description=AdTripwire daily interactive exposure run (Firefox and Chromium, persistent profiles)

[Service]
Type=oneshot
WorkingDirectory=%h/git/AdTripwire
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/snap/bin
# Optional publishing settings (ADTRIPWIRE_OBSERVATORY_REMOTE, ADTRIPWIRE_OBSERVATORY_BRANCH);
# see docs/observatory.md. Without the file, or without a remote in it, nothing is published.
EnvironmentFile=-%h/.config/adtripwire/observatory.env
# Rebuild the evaluation bundles from the checked-out tree so the run always uses the current
# indicator set (pull the repository to pick up merged indicator refreshes).
ExecStartPre=/bin/sh -c 'node scripts/refresh-indicators.mjs --check || true'
ExecStartPre=/bin/sh -c 'node apps/extension-firefox/build.mjs --eval --out=%h/snap/firefox/common/adtripwire-eval-dist && node apps/extension-chromium/build.mjs --eval --out=%h/snap/chromium/common/adtripwire-eval-dist'
# Eight variants (desktop Firefox and Chromium, two phone emulations, and the Norway and
# Middle East/Africa site lists), two at a time: about 4-5 h in all. The logic lives in
# scripts/exposure-daily.sh. A failing variant does not stop the others; reports and JSON stay
# outside the repository, per-variant logs go to live/; the trend report is rebuilt, then the
# observatory site is built and published when a remote is configured (a failing build or publish
# never fails the unit; the unit's status is the trend step's). Parallelism: 1-4, default 2.
Environment=ADTRIPWIRE_EXPOSURE_PARALLEL=2
ExecStart=/bin/sh scripts/exposure-daily.sh
TimeoutStartSec=8h
Nice=10
